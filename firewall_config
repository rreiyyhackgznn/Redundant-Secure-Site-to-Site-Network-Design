FIREWALL CONFIG  (KOMUTLAR PROJEDEN EXPORT EDİLİP GPT TARAFINDAN DÜZELTİLİP EKLENMİŞTİR)

enable
conf t

! ===============================
! BASIC SETTINGS
! ===============================
hostname ASA_5506X
enable password cisco

! ===============================
! INTERFACES
! ===============================
interface gigabitEthernet1/1
 nameif inside
 security-level 100
 ip address 192.168.10.254 255.255.255.0
 no shutdown

interface gigabitEthernet1/2
 nameif outside
 security-level 0
 ip address 200.1.1.2 255.255.255.252
 no shutdown

! ===============================
! ROUTING
! ===============================
route outside 0.0.0.0 0.0.0.0 200.1.1.1

! ===============================
! NAT (PAT)
! ===============================
object network MERKEZ_LAN
 subnet 192.168.10.0 255.255.255.0
 nat (inside,outside) dynamic interface

! ===============================
! ACL – INSIDE SECURITY
! ===============================
access-list INSIDE_IN extended permit ip 192.168.20.0 255.255.255.0 host 192.168.10.10
access-list INSIDE_IN extended permit ip 192.168.30.0 255.255.255.0 host 192.168.10.10
access-list INSIDE_IN extended deny   ip 192.168.20.0 255.255.255.0 192.168.10.0 255.255.255.0
access-list INSIDE_IN extended deny   ip 192.168.30.0 255.255.255.0 192.168.10.0 255.255.255.0
access-list INSIDE_IN extended permit ip any any

access-group INSIDE_IN in interface inside

! ===============================
! ACL – OUTSIDE (DEFAULT DENY)
! ===============================
access-list OUTSIDE_IN extended deny ip any any
access-group OUTSIDE_IN in interface outside

! ===============================
! SYSLOG
! ===============================
logging enable
logging host inside 192.168.10.10
logging trap informational
logging timestamp

! ===============================
! ICMP INSPECTION (PING FIX)
! ===============================
policy-map global_policy
 class inspection_default
  inspect icmp
exit

! ===============================
! VPN – PHASE 1 (IKEv1)
! ===============================
crypto ikev1 policy 10
 authentication pre-share
 encryption aes
 hash sha
 group 2
 lifetime 86400
exit

crypto ikev1 enable outside

! ===============================
! VPN – ACLs
! ===============================
access-list VPN-BR1 extended permit ip 192.168.10.0 255.255.255.0 192.168.20.0 255.255.255.0
access-list VPN-BR2 extended permit ip 192.168.10.0 255.255.255.0 192.168.30.0 255.255.255.0

! ===============================
! VPN – TRANSFORM SET
! ===============================
crypto ipsec ikev1 transform-set TS esp-aes esp-sha-hmac

! ===============================
! VPN – TUNNEL GROUPS
! ===============================
tunnel-group 10.0.0.2 type ipsec-l2l
tunnel-group 10.0.0.2 ipsec-attributes
 ikev1 pre-shared-key cisco123
exit

tunnel-group 10.0.0.6 type ipsec-l2l
tunnel-group 10.0.0.6 ipsec-attributes
 ikev1 pre-shared-key cisco123
exit

! ===============================
! VPN – CRYPTO MAP
! ===============================
crypto map CMAP 10 match address VPN-BR1
crypto map CMAP 10 set peer 10.0.0.2
crypto map CMAP 10 set ikev1 transform-set TS

crypto map CMAP 20 match address VPN-BR2
crypto map CMAP 20 set peer 10.0.0.6
crypto map CMAP 20 set ikev1 transform-set TS

crypto map CMAP interface outside
copy running-config tftp:


! ===============================
! END
! ===============================
end
write memory
